    /** @var string */
    public $document_date = '';
    /** @var string */
    public $due_date = '';
    /** @var string|int */
    public $sales_type = '';
    /** @var string */
    public $sales_type_name = '';
    /** @var string */
    public $customer_currency = '';
    /** @var string|int */
    public $customer_id = '';
    /** @var string */
    public $customer_name = '';
    /** @var string|int */
    public $Branch = '';
    /** @var string */
    public $email = '';
    /** @var string */
    public $deliver_to = '';
    /** @var string */
    public $delivery_address = '';
    /** @var string */
    public $phone = '';
    /** @var string */
    public $cust_ref = '';
    /** @var string */
    public $reference = '';
    /** @var string */
    public $Comments = '';
    /** @var string */
    public $Location = '';
    /** @var string|int */
    public $order_no = 0;
    /** @var int */
    public $ship_via = 0;
    /** @var float */
    public $freight_cost = 0.0;
    /** @var int */
    public $dimension_id = 0;
    /** @var int */
    public $dimension2_id = 0;
    /** @var string|int */
    public $payment = '';
    /** @var array<string, string|int|float|null> */
    public $payment_terms = array();
    /** @var float|null */
    public $price_factor = null;
    /** @var float */
    public $default_discount = 0.0;
    /** @var float|string|null */
    public $ex_rate = null;

    /**
     * @param int $type
     * @param int|array<int, int> $trans_no
     * @param bool|int $prepare_child
     */
    public function __construct($type, $trans_no = 0, $prepare_child = false) {}

    /** @param int $policy */
    public function write($policy = 0): int {}

    public function clear_items(): void {}

    /** @return float */
    public function get_items_total() {}

    /** @return list<string> stock ids that would go below zero */
    public function check_qoh($date = null, $location = null): array {}

    /**
     * @param int $line_no
     * @param string $stock_id
     * @param float|int|string $qty
     * @param float|int|string $price
     * @param float|int|string $disc
     * @param float|int|string $qty_done
     * @param float|int|string $standard_cost
     * @param string|null $description
     */
    public function add_to_cart($line_no, $stock_id, $qty, $price, $disc, $qty_done = 0, $standard_cost = 0, $description = null, $id = 0, $src_no = 0, $src_id = 0): int {}
}

